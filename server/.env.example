# ── LLM 服务商 ──────────────────────────────────────────────────────
# 可选：deepseek | openai | qwen | moonshot | glm | siliconflow | ollama | custom
# 不填也行：会按你配了哪个 Key 自动推断。写别名也能认（aliyun/dashscope/tongyi→qwen、
# kimi→moonshot、zhipu/chatglm→glm、gpt→openai、local→ollama）
LLM_PROVIDER=deepseek

# 通用三件套（填了就覆盖厂商默认值，换任何 OpenAI 兼容服务都靠它）
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=2048

# ── 各厂商的 Key（只填你用的那个；通用的 LLM_API_KEY 对谁都生效）───────
# DeepSeek   控制台 https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# OpenAI
# OPENAI_API_KEY=
# 通义千问 DashScope
# DASHSCOPE_API_KEY=
# Moonshot (Kimi)
# MOONSHOT_API_KEY=
# 智谱 GLM
# ZHIPU_API_KEY=
# 硅基流动
# SILICONFLOW_API_KEY=

# 下面是旧的 DeepSeek 专属变量，仍然生效（优先级低于通用变量），不用可以删
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 没配 key 时设为 true，用离线规则引擎跑通前后端链路（不会调用任何外部 API）
MOCK_LLM=false

# 真实模型调用失败（余额不足 / 限流 / 断网）时，自动降级到离线规则继续干活。
# 默认 false —— 降级会在回复里明确标注「本次由离线规则兜底」，不会假装是模型干的。
LLM_FALLBACK_TO_MOCK=false

# ── 服务与 Agent 参数 ────────────────────────────────────────────────
PORT=8787
# 单轮最多让模型决策几步（防止工具死循环）
AGENT_MAX_STEPS=6
# 每个会话保留的历史消息条数
AGENT_MAX_HISTORY=40
SESSION_TTL_MS=21600000
